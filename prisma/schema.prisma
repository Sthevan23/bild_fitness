generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FINANCEIRO
  EXPEDICAO
  ESTOQUE
}

enum Platform {
  MERCADO_LIVRE
  SHOPEE
  WHATSAPP
  LOJA
}

enum OrderStatus {
  AGUARDANDO
  SEPARANDO
  ENVIADO
  ENTREGUE
  CANCELADO
}

enum MovementType {
  ENTRADA
  SAIDA
}

enum FinanceType {
  ENTRADA
  SAIDA
}

enum FinanceStatus {
  PENDENTE
  PAGO
  RECEBIDO
  CANCELADO
}

enum ImportStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
}

model Company {
  id        String   @id @default(uuid())
  name      String
  logoUrl   String?  @map("logo_url")
  theme     String   @default("light")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users       User[]
  products    Product[]
  customers   Customer[]
  suppliers   Supplier[]
  orders      Order[]
  movements   StockMovement[]
  finance     FinanceEntry[]
  invoices               Invoice[]
  nfeImports             NfeImport[]
  marketplaceConnections MarketplaceConnection[]

  @@map("companies")
}

enum MarketplaceType {
  MERCADO_LIVRE
  SHOPEE
  AMAZON
  MAGALU
  NUVEMSHOP
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  EXPIRED
}

model MarketplaceConnection {
  id                   String           @id @default(uuid())
  companyId            String           @map("company_id")
  company              Company          @relation(fields: [companyId], references: [id])
  marketplace          MarketplaceType
  sellerId             String?          @map("seller_id")
  nickname             String?
  accountName          String?          @map("account_name")
  accessTokenEnc       String           @map("access_token_enc")
  refreshTokenEnc      String           @map("refresh_token_enc")
  expiresAt            DateTime         @map("expires_at")
  status               ConnectionStatus @default(DISCONNECTED)
  lastSyncAt           DateTime?        @map("last_sync_at")
  lastSyncError        String?          @map("last_sync_error")
  lastOrdersSyncAt     DateTime?        @map("last_orders_sync_at")
  scope                String?
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  @@unique([companyId, marketplace])
  @@index([marketplace, status])
  @@map("marketplace_connections")
}

model User {
  id            String    @id @default(uuid())
  companyId     String    @map("company_id")
  company       Company   @relation(fields: [companyId], references: [id])
  name          String
  email         String    @unique
  password      String
  role          Role      @default(ESTOQUE)
  active        Boolean   @default(true)
  emailVerified DateTime? @map("email_verified")
  image         String?
  resetToken    String?   @map("reset_token")
  resetExpires  DateTime? @map("reset_expires")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts  Account[]
  sessions  Session[]
  movements StockMovement[]
  imports   NfeImport[]

  @@index([companyId])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Supplier {
  id        String    @id @default(uuid())
  companyId String    @map("company_id")
  company   Company   @relation(fields: [companyId], references: [id])
  name      String
  phone     String?
  email     String?
  city      String?
  cnpj      String?
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]
  invoices  Invoice[]

  @@index([companyId])
  @@map("suppliers")
}

model Customer {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  phone        String?
  document     String?
  email        String?
  address      String?
  city         String?
  state        String?
  externalId   String?  @map("external_id")
  marketplace  String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  orders       Order[]

  @@index([companyId])
  @@index([companyId, externalId])
  @@map("customers")
}

model Product {
  id            String          @id @default(uuid())
  companyId     String          @map("company_id")
  company       Company         @relation(fields: [companyId], references: [id])
  name          String
  sku           String
  barcode       String?         @map("barcode")
  category      String?
  unit          String?         @default("UN")
  stock         Decimal         @default(0)
  minStock      Decimal         @default(5) @map("min_stock")
  costPrice     Decimal         @default(0) @map("cost_price")
  avgCost       Decimal         @default(0) @map("avg_cost")
  salePrice     Decimal         @default(0) @map("sale_price")
  brand         String?
  linkedSkus    String?         @map("linked_skus")
  imageUrl      String?         @map("image_url")
  mlItemId      String?         @map("ml_item_id")
  mlStatus      String?         @map("ml_status")
  supplierId    String?         @map("supplier_id")
  supplier      Supplier?       @relation(fields: [supplierId], references: [id])
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  movements     StockMovement[]
  orderItems    OrderItem[]

  @@unique([companyId, sku])
  @@index([companyId, name])
  @@index([companyId, mlItemId])
  @@map("products")
}

model StockMovement {
  id          String       @id @default(uuid())
  companyId   String       @map("company_id")
  company     Company      @relation(fields: [companyId], references: [id])
  productId   String       @map("product_id")
  product     Product      @relation(fields: [productId], references: [id])
  type        MovementType
  quantity    Decimal
  unitCost    Decimal      @default(0) @map("unit_cost")
  totalCost   Decimal      @default(0) @map("total_cost")
  note        String?
  orderId     String?      @map("order_id")
  order       Order?       @relation(fields: [orderId], references: [id])
  invoiceId   String?      @map("invoice_id")
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id])
  userId      String?      @map("user_id")
  user        User?        @relation(fields: [userId], references: [id])
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@map("stock_movements")
}

model Order {
  id              String        @id @default(uuid())
  companyId       String        @map("company_id")
  company         Company       @relation(fields: [companyId], references: [id])
  number          String
  customerId      String?       @map("customer_id")
  customer        Customer?     @relation(fields: [customerId], references: [id])
  platform        Platform
  status          OrderStatus   @default(AGUARDANDO)
  paymentMethod   String?       @map("payment_method")
  trackingCode    String?       @map("tracking_code")
  total           Decimal       @default(0)
  freight         Decimal       @default(0)
  marketplaceFee  Decimal       @default(0) @map("marketplace_fee")
  netAmount       Decimal       @default(0) @map("net_amount")
  externalId      String?       @map("external_id")
  shippingId      String?       @map("shipping_id")
  stockDeducted   Boolean       @default(false) @map("stock_deducted")
  notes           String?
  orderedAt       DateTime      @default(now()) @map("ordered_at")
  shippedAt       DateTime?     @map("shipped_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  items           OrderItem[]
  movements       StockMovement[]
  finance         FinanceEntry[]

  @@unique([companyId, number])
  @@unique([companyId, externalId])
  @@index([companyId, status, orderedAt])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String  @map("order_id")
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String  @map("product_id")
  product    Product @relation(fields: [productId], references: [id])
  quantity   Decimal
  unitPrice  Decimal @map("unit_price")
  totalPrice Decimal @map("total_price")

  @@map("order_items")
}

model FinanceEntry {
  id          String        @id @default(uuid())
  companyId   String        @map("company_id")
  company     Company       @relation(fields: [companyId], references: [id])
  type        FinanceType
  status      FinanceStatus @default(PENDENTE)
  description String
  amount      Decimal
  dueDate     DateTime?     @map("due_date")
  paidAt      DateTime?     @map("paid_at")
  category    String?
  orderId     String?       @map("order_id")
  order       Order?        @relation(fields: [orderId], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([companyId, type, dueDate])
  @@map("finance_entries")
}

model Invoice {
  id             String          @id @default(uuid())
  companyId      String          @map("company_id")
  company        Company         @relation(fields: [companyId], references: [id])
  number         String
  series         String
  accessKey      String          @unique @map("access_key")
  supplierId     String?         @map("supplier_id")
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  totalValue     Decimal         @map("total_value")
  taxValue       Decimal?        @map("tax_value")
  freight        Decimal?
  discount       Decimal?
  issuedAt       DateTime        @map("issued_at")
  importedAt     DateTime        @default(now()) @map("imported_at")
  importId       String?         @map("import_id")
  import         NfeImport?      @relation(fields: [importId], references: [id])
  movements      StockMovement[]

  @@index([companyId])
  @@map("invoices")
}

model NfeImport {
  id              String       @id @default(uuid())
  companyId       String       @map("company_id")
  company         Company      @relation(fields: [companyId], references: [id])
  userId          String       @map("user_id")
  user            User         @relation(fields: [userId], references: [id])
  accessKey       String       @map("access_key")
  totalItems      Int          @map("total_items")
  itemsUpdated    Int          @map("items_updated")
  itemsCreated    Int          @map("items_created")
  totalValue      Decimal      @map("total_value")
  status          ImportStatus @default(PENDING)
  createdAt       DateTime     @default(now()) @map("created_at")
  invoices        Invoice[]

  @@unique([companyId, accessKey])
  @@map("nfe_imports")
}
