# Banco PostgreSQL (Neon / Docker / Vercel)
# Neon: https://neon.tech → New Project → copie a connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# NextAuth (use a URL da Vercel depois do deploy)
NEXTAUTH_URL="https://seu-projeto.vercel.app"
NEXTAUTH_SECRET="gere-um-segredo-longo-aleatorio"

# Criptografia dos tokens de marketplace
TOKEN_ENCRYPTION_KEY="gere-outra-chave-longa-aleatoria"

# Mercado Livre OAuth
ML_CLIENT_ID=""
ML_CLIENT_SECRET=""
ML_REDIRECT_URI="https://seu-projeto.vercel.app/api/marketplace/mercadolivre/callback"

# Cron de sync (opcional)
CRON_SECRET="gere-um-segredo-cron"

# Docker local (opcional):
# DATABASE_URL="postgresql://pep:pep123@localhost:5432/pep_vendas?schema=public"
