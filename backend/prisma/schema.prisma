generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FINANCEIRO
  EXPEDICAO
  ESTOQUE
}

enum Platform {
  MERCADO_LIVRE
  SHOPEE
  WHATSAPP
  LOJA
}

enum OrderStatus {
  AGUARDANDO
  SEPARANDO
  ENVIADO
  ENTREGUE
  CANCELADO
}

enum MovementType {
  ENTRADA
  SAIDA
}

enum FinanceType {
  ENTRADA
  SAIDA
}

enum FinanceStatus {
  PENDENTE
  PAGO
  RECEBIDO
  CANCELADO
}

enum ImportStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
}

model Company {
  id        String   @id @default(uuid())
  name      String
  logoUrl   String?  @map("logo_url")
  theme     String   @default("planilha")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                  User[]
  products               Product[]
  customers              Customer[]
  suppliers              Supplier[]
  orders                 Order[]
  movements              StockMovement[]
  finance                FinanceEntry[]
  invoices               Invoice[]
  nfeImports             NfeImport[]
  marketplaceConnections MarketplaceConnection[]
  salesAccounts          SalesAccount[]
  accountTaxRates        AccountTaxRate[]
  modelCosts             ModelCost[]
  mlSaleRaws             MlSaleRaw[]
  purchaseDeliveries     PurchaseDelivery[]
  spreadsheetImports     SpreadsheetImport[]
  costAllocations        CostAllocation[]

  @@map("companies")
}

/** Contas/CNPJs da empresa (P&P, RC, PCP) com estoque separado */
model SalesAccount {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code      String
  name      String
  cnpj      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stocks      AccountStock[]
  orders      Order[]
  movements   StockMovement[]
  connections MarketplaceConnection[]
  taxRates    AccountTaxRate[]
  mlSales     MlSaleRaw[]
  deliveries  PurchaseDelivery[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("sales_accounts")
}

model AccountTaxRate {
  id                  String       @id @default(uuid())
  companyId           String       @map("company_id")
  company             Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId           String       @map("account_id")
  account             SalesAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channel             String       @default("ML")
  ratePercent         Decimal      @map("rate_percent")
  /** Meta de margem de lucro desejada (%) — usada para destacar vendas abaixo da meta */
  targetMarginPercent Decimal      @default(15) @map("target_margin_percent")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  @@unique([accountId, channel])
  @@index([companyId])
  @@map("account_tax_rates")
}

model ModelCost {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  modelCode String   @map("model_code")
  costPerKg Decimal  @map("cost_per_kg")
  supplier  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, modelCode])
  @@map("model_costs")
}

model AccountStock {
  id        String       @id @default(uuid())
  accountId String       @map("account_id")
  account   SalesAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId String       @map("product_id")
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  stock     Decimal      @default(0)
  minStock  Decimal      @default(5) @map("min_stock")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([accountId, productId])
  @@index([productId])
  @@map("account_stocks")
}

enum MarketplaceType {
  MERCADO_LIVRE
  SHOPEE
  AMAZON
  MAGALU
  NUVEMSHOP
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  EXPIRED
}

model MarketplaceConnection {
  id                   String           @id @default(uuid())
  companyId            String           @map("company_id")
  company              Company          @relation(fields: [companyId], references: [id])
  accountId            String?          @map("account_id")
  account              SalesAccount?    @relation(fields: [accountId], references: [id])
  marketplace          MarketplaceType
  sellerId             String?          @map("seller_id")
  nickname             String?
  accountName          String?          @map("account_name")
  accessTokenEnc       String           @map("access_token_enc")
  refreshTokenEnc      String           @map("refresh_token_enc")
  expiresAt            DateTime         @map("expires_at")
  status               ConnectionStatus @default(DISCONNECTED)
  lastSyncAt           DateTime?        @map("last_sync_at")
  lastSyncError        String?          @map("last_sync_error")
  lastOrdersSyncAt     DateTime?        @map("last_orders_sync_at")
  scope                String?
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  @@unique([companyId, marketplace, accountId])
  @@index([marketplace, status])
  @@map("marketplace_connections")
}

model User {
  id            String    @id @default(uuid())
  companyId     String    @map("company_id")
  company       Company   @relation(fields: [companyId], references: [id])
  name          String
  email         String    @unique
  password      String
  role          Role      @default(ESTOQUE)
  active        Boolean   @default(true)
  emailVerified DateTime? @map("email_verified")
  image         String?
  resetToken    String?   @map("reset_token")
  resetExpires  DateTime? @map("reset_expires")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts  Account[]
  sessions  Session[]
  movements StockMovement[]
  imports   NfeImport[]

  @@index([companyId])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Supplier {
  id        String    @id @default(uuid())
  companyId String    @map("company_id")
  company   Company   @relation(fields: [companyId], references: [id])
  name      String
  phone     String?
  email     String?
  city      String?
  cnpj      String?
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]
  invoices  Invoice[]

  @@index([companyId])
  @@map("suppliers")
}

model Customer {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  phone        String?
  document     String?
  email        String?
  address      String?
  city         String?
  state        String?
  externalId   String?  @map("external_id")
  marketplace  String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  orders       Order[]

  @@index([companyId])
  @@index([companyId, externalId])
  @@map("customers")
}

model Product {
  id            String          @id @default(uuid())
  companyId     String          @map("company_id")
  company       Company         @relation(fields: [companyId], references: [id])
  name          String
  sku           String
  barcode       String?         @map("barcode")
  category      String?
  unit          String?         @default("UN")
  stock         Decimal         @default(0)
  minStock      Decimal         @default(5) @map("min_stock")
  costPrice     Decimal         @default(0) @map("cost_price")
  avgCost       Decimal         @default(0) @map("avg_cost")
  salePrice     Decimal         @default(0) @map("sale_price")
  brand         String?
  linkedSkus    String?         @map("linked_skus")
  weightKg      Decimal?        @map("weight_kg")
  modelCode     String?         @map("model_code")
  imageUrl      String?         @map("image_url")
  mlItemId      String?         @map("ml_item_id")
  mlStatus      String?         @map("ml_status")
  supplierId    String?         @map("supplier_id")
  supplier      Supplier?       @relation(fields: [supplierId], references: [id])
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  movements     StockMovement[]
  orderItems    OrderItem[]
  accountStocks AccountStock[]
  kitAsKit      ProductKitComponent[] @relation("KitProduct")
  kitAsComponent ProductKitComponent[] @relation("ComponentProduct")
  deliveryLines PurchaseDeliveryLine[]

  @@unique([companyId, sku])
  @@index([companyId, name])
  @@index([companyId, mlItemId])
  @@map("products")
}

model ProductKitComponent {
  id                 String  @id @default(uuid())
  kitProductId       String  @map("kit_product_id")
  kitProduct         Product @relation("KitProduct", fields: [kitProductId], references: [id], onDelete: Cascade)
  componentProductId String  @map("component_product_id")
  componentProduct   Product @relation("ComponentProduct", fields: [componentProductId], references: [id], onDelete: Cascade)
  quantity           Decimal @default(1)

  @@unique([kitProductId, componentProductId])
  @@index([componentProductId])
  @@map("product_kit_components")
}

model StockMovement {
  id          String        @id @default(uuid())
  companyId   String        @map("company_id")
  company     Company       @relation(fields: [companyId], references: [id])
  accountId   String?       @map("account_id")
  account     SalesAccount? @relation(fields: [accountId], references: [id])
  productId   String        @map("product_id")
  product     Product       @relation(fields: [productId], references: [id])
  type        MovementType
  quantity    Decimal
  unitCost    Decimal       @default(0) @map("unit_cost")
  totalCost   Decimal       @default(0) @map("total_cost")
  note        String?
  orderId     String?       @map("order_id")
  order       Order?        @relation(fields: [orderId], references: [id])
  invoiceId   String?       @map("invoice_id")
  invoice     Invoice?      @relation(fields: [invoiceId], references: [id])
  userId      String?       @map("user_id")
  user        User?         @relation(fields: [userId], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@index([accountId, createdAt])
  @@map("stock_movements")
}

model Order {
  id              String        @id @default(uuid())
  companyId       String        @map("company_id")
  company         Company       @relation(fields: [companyId], references: [id])
  accountId       String?       @map("account_id")
  account         SalesAccount? @relation(fields: [accountId], references: [id])
  number          String
  customerId      String?       @map("customer_id")
  customer        Customer?     @relation(fields: [customerId], references: [id])
  platform        Platform
  status          OrderStatus   @default(AGUARDANDO)
  paymentMethod   String?       @map("payment_method")
  trackingCode    String?       @map("tracking_code")
  total           Decimal       @default(0)
  freight         Decimal       @default(0)
  marketplaceFee  Decimal       @default(0) @map("marketplace_fee")
  netAmount       Decimal       @default(0) @map("net_amount")
  externalId      String?       @map("external_id")
  shippingId      String?       @map("shipping_id")
  stockDeducted   Boolean       @default(false) @map("stock_deducted")
  notes           String?
  orderedAt       DateTime      @default(now()) @map("ordered_at")
  shippedAt       DateTime?     @map("shipped_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  items           OrderItem[]
  movements       StockMovement[]
  finance         FinanceEntry[]

  @@unique([companyId, number])
  @@unique([companyId, externalId])
  @@index([companyId, status, orderedAt])
  @@index([accountId, orderedAt])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String  @map("order_id")
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String  @map("product_id")
  product      Product @relation(fields: [productId], references: [id])
  quantity     Decimal
  unitPrice    Decimal @map("unit_price")
  totalPrice   Decimal @map("total_price")
  productCost  Decimal @default(0) @map("product_cost")
  taxAmount    Decimal @default(0) @map("tax_amount")
  grossProfit  Decimal @default(0) @map("gross_profit")
  marginPercent Decimal @default(0) @map("margin_percent")

  @@map("order_items")
}

model FinanceEntry {
  id          String        @id @default(uuid())
  companyId   String        @map("company_id")
  company     Company       @relation(fields: [companyId], references: [id])
  type        FinanceType
  status      FinanceStatus @default(PENDENTE)
  description String
  amount      Decimal
  dueDate     DateTime?     @map("due_date")
  paidAt      DateTime?     @map("paid_at")
  category    String?
  orderId     String?       @map("order_id")
  order       Order?        @relation(fields: [orderId], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([companyId, type, dueDate])
  @@map("finance_entries")
}

model Invoice {
  id             String          @id @default(uuid())
  companyId      String          @map("company_id")
  company        Company         @relation(fields: [companyId], references: [id])
  number         String
  series         String
  accessKey      String          @unique @map("access_key")
  supplierId     String?         @map("supplier_id")
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  totalValue     Decimal         @map("total_value")
  taxValue       Decimal?        @map("tax_value")
  freight        Decimal?
  discount       Decimal?
  issuedAt       DateTime        @map("issued_at")
  importedAt     DateTime        @default(now()) @map("imported_at")
  importId       String?         @map("import_id")
  import         NfeImport?      @relation(fields: [importId], references: [id])
  movements      StockMovement[]

  @@index([companyId])
  @@map("invoices")
}

model NfeImport {
  id              String       @id @default(uuid())
  companyId       String       @map("company_id")
  company         Company      @relation(fields: [companyId], references: [id])
  userId          String       @map("user_id")
  user            User         @relation(fields: [userId], references: [id])
  accessKey       String       @map("access_key")
  totalItems      Int          @map("total_items")
  itemsUpdated    Int          @map("items_updated")
  itemsCreated    Int          @map("items_created")
  totalValue      Decimal      @map("total_value")
  status          ImportStatus @default(PENDING)
  createdAt       DateTime     @default(now()) @map("created_at")
  invoices        Invoice[]

  @@unique([companyId, accessKey])
  @@map("nfe_imports")
}

/** Staging do relatório ML (aba Dados_ML) */
model MlSaleRaw {
  id               String        @id @default(uuid())
  companyId        String        @map("company_id")
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId        String?       @map("account_id")
  account          SalesAccount? @relation(fields: [accountId], references: [id])
  externalSaleId   String        @map("external_sale_id")
  soldAt           DateTime?     @map("sold_at")
  sku              String?
  title            String?
  units            Decimal       @default(1)
  revenueProducts  Decimal       @default(0) @map("revenue_products")
  fees             Decimal       @default(0)
  shippingRevenue  Decimal       @default(0) @map("shipping_revenue")
  shippingFees     Decimal       @default(0) @map("shipping_fees")
  total            Decimal       @default(0)
  buyerName        String?       @map("buyer_name")
  status           String?
  mlItemId         String?       @map("ml_item_id")
  rawJson          String?       @map("raw_json")
  importBatchId    String?       @map("import_batch_id")
  createdAt        DateTime      @default(now()) @map("created_at")

  @@unique([companyId, externalSaleId])
  @@index([companyId, soldAt])
  @@index([accountId, soldAt])
  @@map("ml_sale_raws")
}

enum PurchaseDeliveryStatus {
  PEDIDO
  ENTREGA
}

model PurchaseDelivery {
  id          String                 @id @default(uuid())
  companyId   String                 @map("company_id")
  company     Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId   String                 @map("account_id")
  account     SalesAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  supplierName String?               @map("supplier_name")
  status      PurchaseDeliveryStatus @default(PEDIDO)
  orderedAt   DateTime?              @map("ordered_at")
  deliveredAt DateTime?              @map("delivered_at")
  notes       String?
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  stockApplied Boolean                @default(false) @map("stock_applied")
  lines       PurchaseDeliveryLine[]

  @@index([companyId, accountId])
  @@map("purchase_deliveries")
}

model PurchaseDeliveryLine {
  id         String           @id @default(uuid())
  deliveryId String           @map("delivery_id")
  delivery   PurchaseDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  productId  String?          @map("product_id")
  product    Product?         @relation(fields: [productId], references: [id])
  description String
  quantity   Decimal          @default(0)
  unitCost   Decimal          @default(0) @map("unit_cost")

  @@map("purchase_delivery_lines")
}

model SpreadsheetImport {
  id           String       @id @default(uuid())
  companyId    String       @map("company_id")
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fileName     String       @map("file_name")
  status       ImportStatus @default(PENDING)
  productsUpserted Int      @default(0) @map("products_upserted")
  salesImported    Int      @default(0) @map("sales_imported")
  stockUpdated     Int      @default(0) @map("stock_updated")
  deliveriesImported Int    @default(0) @map("deliveries_imported")
  financeImported  Int      @default(0) @map("finance_imported")
  message      String?
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@map("spreadsheet_imports")
}

/** Custos fixos/variáveis com rateio % (aba FINANCEIRO) */
model CostAllocation {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  monthLabel  String   @map("month_label")
  category    String
  description String
  amount      Decimal  @default(0)
  ratePcp     Decimal  @default(0) @map("rate_pcp")
  rateRc      Decimal  @default(0) @map("rate_rc")
  ratePp      Decimal  @default(0) @map("rate_pp")
  allocatedPcp Decimal @default(0) @map("allocated_pcp")
  allocatedRc  Decimal @default(0) @map("allocated_rc")
  allocatedPp  Decimal @default(0) @map("allocated_pp")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([companyId, monthLabel, description])
  @@index([companyId, monthLabel])
  @@map("cost_allocations")
}
