{
  "name": "pep-vendas",
  "version": "3.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "db:generate": "npm run db:generate -w backend",
    "db:push": "npm run db:push -w backend",
    "db:seed": "npm run db:seed -w backend",
    "postinstall": "npm run build -w @pep/shared --if-present && npm run db:generate -w backend --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "next": {
      "postcss": "^8.5.25",
      "sharp": "^0.35.3"
    }
  }
}
